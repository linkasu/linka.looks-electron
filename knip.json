{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/electron/main.ts",
    "src/frontend/tests/unit/**/*.spec.ts",
    "src/electron/tests/unit/**/*.spec.ts",
    "tests/e2e/**/*.spec.ts",
    "tests/packaged/**/*.spec.ts",
    "scripts/ci/*.{js,cjs,mjs,ts}",
    "postinstall.js"
  ],
  "project": ["src/**/*.{ts,vue}", "scripts/**/*.{js,mjs,ts}", "tests/**/*.ts"],
  "ignoreDependencies": ["original-fs", "node-gyp"],
  "ignoreExportsUsedInFile": true
}
