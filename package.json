{
  "name": "linka.looks",
  "version": "3.2.12",
  "author": "ibakaidov",
  "private": true,
  "engines": {
    "npm": ">=10.9.0 <11.0.0",
    "node": ">=22.12.0 <23.0.0"
  },
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkasu/linka.looks-electron.git"
  },
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint-fix": "eslint --fix --ext .js,.cjs,.mjs,.vue,.ts .",
    "lint": "eslint --ext .js,.cjs,.mjs,.vue,.ts .",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,vue,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,vue,json,yml,yaml,md}\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:unit": "vitest run && vitest run --config vitest.node.config.ts",
    "test:unit:coverage": "vitest run --coverage && vitest run --config vitest.node.config.ts --coverage",
    "test:e2e": "npm run build && playwright test",
    "native:build": "npm --prefix node_modules/@linkasu/tobii-electron run native:build",
    "native:test-load": "npm --prefix node_modules/@linkasu/tobii-electron run native:test-load",
    "test:packaged-resources": "node scripts/ci/packaged-resources-smoke.js",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run electron:build -- --win -p never",
    "electron:build:mac": "npm run electron:build -- --mac --x64 --arm64 -p never",
    "electron:build:linux": "npm run electron:build -- --linux -p never",
    "electron:serve": "vite",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "@linkasu/tobii-electron": "https://github.com/linkasu/linka-tobii-electron/releases/download/v0.2.16/linkasu-tobii-electron-0.2.16.tgz",
    "@mdi/font": "7.3.67",
    "@sindresorhus/chunkify": "^0.2.0",
    "@types/adm-zip": "^0.5.0",
    "adm-zip": "^0.5.10",
    "archiver": "^5.3.1",
    "axios": "^1.6.0",
    "core-js": "^3.33.0",
    "delay": "^5.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "gamepad-wrapper": "^1.2.0",
    "is-valid-path": "^0.1.1",
    "linebreak-next": "^1.0.3",
    "pictures.bank-api": "https://github.com/linkasu/pictures.bank-client.git",
    "roboto-fontface": "*",
    "uuid": "^14.0.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.12.5",
    "vuex": "^4.1.0",
    "webfontloader": "^1.0.0"
  },
  "build": {
    "productName": "LINKa. смотри",
    "appId": "su.linka.looks",
    "asarUnpack": [
      "node_modules/@linkasu/tobii-electron/native/tobiifree-native/**/*.node",
      "node_modules/@linkasu/tobii-electron/node_modules/@linka/tobiifree-native/**/*.node",
      "node_modules/@linka/tobiifree-native/**/*.node"
    ],
    "files": [
      "dist/**/*",
      "!dist/mac/**/*",
      "!dist/mac-arm64/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.dmg",
      "!dist/*.zip",
      "!dist/*.blockmap",
      "!dist/latest*.yml",
      "!dist/builder-debug.yml",
      "dist-electron/**/*",
      "node_modules/@linkasu/tobii-electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "linka"
      }
    ],
    "publish": [
      "github"
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "category": "Education",
      "maintainer": "Ivan Bakaidov <ivan@aacidov.ru>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "perMachine": true
    },
    "extraResources": [
      {
        "from": "./extraResources/",
        "to": "extraResources",
        "filter": [
          "**/*",
          "!defaultSets/**/*",
          "defaultSets/Клавиатура.linka",
          "defaultSets/Крупная клавиатура/**/*",
          "defaultSets/цифры знаки.linka"
        ]
      },
      {
        "from": "./node_modules/@linkasu/tobii-electron/tools/tobiifree-helper/",
        "to": "extraResources/bin/tobiifree-helper",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./node_modules/@linkasu/tobii-electron/tools/tobiifree-sdk/",
        "to": "extraResources/bin/tobiifree-sdk",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./node_modules/usb/",
        "to": "extraResources/bin/node_modules/usb",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./node_modules/node-gyp-build/",
        "to": "extraResources/bin/node_modules/node-gyp-build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./node_modules/@linkasu/tobii-electron/extraResources/bin/",
        "to": "extraResources/bin",
        "filter": [
          "EyeLog.exe",
          "*.dll",
          "*.config"
        ]
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/archiver": "^5.3.2",
    "@types/chai": "^4.2.15",
    "@types/electron-devtools-installer": "^2.2.0",
    "@types/is-valid-path": "^0.1.0",
    "@types/webfontloader": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "chai": "^4.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.4.1",
    "node-gyp": "^11.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.5"
  },
  "packageManager": "npm@10.9.7",
  "lint-staged": {
    "*.{js,cjs,mjs,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
