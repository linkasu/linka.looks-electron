# Full-repo gate before anything leaves the machine. Set
# LINKA_PRE_PUSH_SKIP=1 to bypass when pushing a known-broken WIP branch.
if [ -n "${LINKA_PRE_PUSH_SKIP-}" ]; then
  echo "Skipping pre-push checks because LINKA_PRE_PUSH_SKIP is set."
  exit 0
fi

npm run format:check
npm run lint
npm run typecheck
